# Python virtual environments (one per scraper: source/*/.venv)
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]

# Editable-install build metadata (source/jcre uses pip install -e .)
*.egg-info/
build/
dist/

# Scrape output — regenerated by each source's run_scraper.sh, never committed.
# All scrapers write these into their own project directory.
catalog.json
data/
state/
logs/
output/
jcre-output/
smoke-output/
browser-profile/

# Per-scraper report files
inventory_summary.json
missing_paper_links.json

# Partial downloads left behind by an interrupted run
*.part
.*.part

# Local credentials and browser session material — never commit these.
# aea-icpsr takes --cookie-file; political-analysis sources .env in run_scraper.sh.
.env
.env.*
!.env.example
cookies.txt
*.cookies.txt

# OS cruft
.DS_Store
Thumbs.db
