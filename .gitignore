# Python virtual environments (one per scraper: source/*/.venv)
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]

# Editable-install build metadata. Most sources pip install -e . from
# run_scraper.sh, which leaves an .egg-info beside the package.
*.egg-info/
build/
dist/

# Scrape output — regenerated by run_script.sh or any source's run_scraper.sh,
# never committed. Every scraper defaults to output/ and uses smoke-output/
# under --smoke-test; the root orchestrator writes output/runs/<start>_to_<end>/.
output/
# Covers smoke-output/, any legacy per-source dir such as jcre-output/ left over
# from before the output/ default, and any custom "<name>-output" directory.
*-output/

# Output subtrees, in case a scraper is pointed at a custom --output-root.
catalog.json
data/
state/
logs/
browser-profile/

# Per-source report files
inventory_summary.json
missing_paper_links.json

# Partial downloads left behind by an interrupted run
*.part
.*.part
*.part.json

# Local credentials and browser session material — never commit these.
# aea-icpsr takes --cookie-file; political-analysis sources .env in run_scraper.sh.
.env
.env.*
!.env.example
cookies.txt
*.cookies.txt

# OS cruft
.DS_Store
Thumbs.db
