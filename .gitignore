# Python virtual environments (one per scraper: source/*/.venv)
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]

# Scrape output — regenerated by each source's run_scraper.sh, never committed.
# All scrapers write these into their own project directory.
catalog.json
data/
state/
logs/
smoke-output/

# Per-scraper report files
inventory_summary.json
missing_paper_links.json

# Partial downloads left behind by an interrupted run
*.part
.*.part

# OS cruft
.DS_Store
