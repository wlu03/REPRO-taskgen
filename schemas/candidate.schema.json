{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiuc-kang-lab.github.io/repro-taskgen/schemas/candidate.schema.json",
  "title": "REPRO-taskgen canonical candidate",
  "description": "A source-independent paper/package/assessment candidate. Gold labels and finding outcomes are intentionally excluded and belong in assessment.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "workflow_state",
    "paper",
    "source_observations",
    "artifacts",
    "relations",
    "screening",
    "temporal",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^(repro|provisional)_[a-z0-9][a-z0-9_-]{7,95}$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "workflow_state": {
      "enum": [
        "discovered",
        "normalized",
        "identity_review",
        "package_match",
        "eligibility_review",
        "artifact_review",
        "execution_review",
        "annotation",
        "adjudication",
        "release_ready",
        "released",
        "blocked",
        "excluded"
      ]
    },
    "paper": {
      "$ref": "#/$defs/paper"
    },
    "source_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceObservation"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "screening": {
      "$ref": "#/$defs/screening"
    },
    "temporal": {
      "$ref": "#/$defs/temporal"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      },
      "default": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value",
        "normalized_value",
        "entity_type",
        "source_observation_id"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "doi",
            "orcid",
            "issn",
            "isbn",
            "openalex",
            "dataverse_pid",
            "zenodo_record_id",
            "zenodo_concept_id",
            "icpsr_study_id",
            "world_bank_reference_id",
            "codecheck_certificate_id",
            "jcre_doi",
            "url",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "normalized_value": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "paper",
            "package_family",
            "package_release",
            "assessment",
            "report",
            "certificate",
            "person",
            "other"
          ]
        },
        "resolver_status": {
          "enum": [
            "not_checked",
            "resolved",
            "not_found",
            "invalid",
            "error"
          ],
          "default": "not_checked"
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_observation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "orcid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$"
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "doi",
        "title",
        "authors",
        "identifiers",
        "discipline_status"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "landing_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true,
          "default": []
        },
        "discipline_status": {
          "enum": [
            "social_science",
            "not_social_science",
            "uncertain"
          ]
        },
        "discipline_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "sourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_observation_id",
        "source_key",
        "source_record_id",
        "source_url",
        "harvest_run_id",
        "harvested_at",
        "raw_sha256",
        "raw_path",
        "query_scope"
      ],
      "properties": {
        "source_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]+$"
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "harvest_run_id": {
          "type": "string",
          "minLength": 1
        },
        "harvested_at": {
          "type": "string",
          "format": "date-time"
        },
        "upstream_created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "upstream_updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_path": {
          "type": "string",
          "minLength": 1
        },
        "query_scope": {
          "type": "object",
          "description": "Canonicalized connector parameters used to obtain this observation."
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "visibility",
        "family_key",
        "release_key",
        "source_url",
        "source_observation_ids",
        "access_status",
        "download_status",
        "license_decision"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "paper_pdf",
            "author_package",
            "readme",
            "code",
            "data",
            "environment",
            "expected_output",
            "reproduction_report",
            "certificate",
            "replication_study_package",
            "other"
          ]
        },
        "visibility": {
          "enum": [
            "agent_visible",
            "curator_only"
          ]
        },
        "family_key": {
          "type": "string",
          "minLength": 1
        },
        "release_key": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "default": []
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "upstream_checksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_blob_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "access_status": {
          "enum": [
            "public",
            "embargoed",
            "restricted",
            "guestbook_or_terms",
            "authentication_required",
            "unavailable",
            "unknown"
          ]
        },
        "download_status": {
          "enum": [
            "not_requested",
            "metadata_only",
            "downloaded_verified",
            "skipped_size",
            "blocked_access",
            "blocked_terms",
            "failed",
            "quarantined"
          ]
        },
        "license_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "license_decision": {
          "enum": [
            "redistribute",
            "redistribute_with_attribution",
            "reference_only_refetch",
            "restricted_internal_only",
            "unknown_needs_review",
            "exclude"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "reproduction_report",
                  "certificate"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "visibility": {
                "const": "curator_only"
              }
            }
          }
        }
      ]
    },
    "relationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source_observation_id",
        "confidence"
      ],
      "properties": {
        "method": {
          "enum": [
            "equal_persistent_identifier",
            "explicit_typed_relation",
            "assessment_registry_reference",
            "structured_citation",
            "title_author_year_candidate",
            "manual_verification"
          ]
        },
        "source_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "quoted_value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "subject_entity_type",
        "subject_id",
        "predicate",
        "object_entity_type",
        "object_id",
        "evidence",
        "review_status"
      ],
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_entity_type": {
          "enum": [
            "paper",
            "artifact",
            "assessment"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "enum": [
            "describes",
            "is_version_of",
            "supplements",
            "authored_package_for",
            "assesses",
            "checks_release",
            "replicates_with_new_data",
            "replies_to",
            "contains",
            "produces"
          ]
        },
        "object_entity_type": {
          "enum": [
            "paper",
            "artifact",
            "assessment"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relationEvidence"
          }
        },
        "review_status": {
          "enum": [
            "auto_verified",
            "needs_review",
            "human_verified",
            "rejected"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "status",
        "reason_codes",
        "evidence_ids"
      ],
      "properties": {
        "gate_id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8",
            "C9"
          ]
        },
        "status": {
          "enum": [
            "not_reviewed",
            "pass",
            "fail",
            "uncertain",
            "not_applicable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]+$"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_status",
        "rubric_version",
        "gates"
      ],
      "properties": {
        "overall_status": {
          "enum": [
            "not_screened",
            "in_progress",
            "eligible",
            "blocked",
            "excluded"
          ]
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gateDecision"
          },
          "maxItems": 9
        },
        "primary_exclusion_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_first_public_at",
        "package_release_at",
        "report_release_at",
        "task_first_public_at"
      ],
      "properties": {
        "paper_first_public_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "package_release_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "report_release_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "task_first_public_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "knowledge_cutoff_slices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cutoff",
              "status"
            ],
            "properties": {
              "cutoff": {
                "type": "string",
                "format": "date"
              },
              "status": {
                "enum": [
                  "all_evidence_post_cutoff",
                  "report_post_cutoff",
                  "pre_cutoff_components_present",
                  "unknown"
                ]
              }
            }
          },
          "default": []
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "archive_scan",
        "secret_scan",
        "malware_scan"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_scanned",
            "pass",
            "quarantined",
            "fail"
          ]
        },
        "archive_scan": {
          "enum": [
            "not_run",
            "pass",
            "warning",
            "fail"
          ]
        },
        "secret_scan": {
          "enum": [
            "not_run",
            "pass",
            "warning",
            "fail"
          ]
        },
        "malware_scan": {
          "enum": [
            "not_run",
            "pass",
            "warning",
            "fail"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_id",
        "created_at",
        "text"
      ],
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
